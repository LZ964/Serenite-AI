# STRIPE_SECRET_KEY: Secret key for Stripe integration.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Secret key for Stripe webhooks.
STRIPE_WEBHOOK_SECRET="whsec_..."

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: The ID of your Firebase project.
# This helps the server initialize Firebase Admin properly.
FIREBASE_PROJECT_ID="gen-lang-client-..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
