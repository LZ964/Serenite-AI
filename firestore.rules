rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBALS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.get('email_verified', false) == true || request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // TEST CONNECTION
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.get('uid', '') is string
          && (data.get('email', null) == null || data.get('email', '') is string)
          && (data.get('points', 0) is int || data.get('points', 0) is float)
          && data.get('isPremium', false) is bool
          && (data.get('requestCount', 0) is int || data.get('requestCount', 0) is float)
          && (data.get('displayName', null) == null || data.get('displayName', '') is string)
          && (data.get('photoURL', null) == null || data.get('photoURL', '') is string)
          && (data.get('sobrietyDate', null) == null || data.get('sobrietyDate', '') is string)
          && (data.get('recoveryStartDate', null) == null || data.get('recoveryStartDate', '') is string)
          && (data.get('lastGratitudeAt', null) == null || data.get('lastGratitudeAt', '') is string)
          && (data.get('lastSobrietyCheck', null) == null || data.get('lastSobrietyCheck', '') is string)
          && (data.get('higherPower', null) == null || data.get('higherPower', '') is string)
          && (data.get('sponsorGender', null) == null || data.get('sponsorGender', '') is string)
          && (data.get('birthDate', null) == null || data.get('birthDate', '') is string)
          && (data.get('currentStep', null) == null || data.get('currentStep', '') is string)
          && (data.get('language', null) == null || data.get('language', '') is string)
          && (data.get('challenges', null) == null || data.get('challenges', []) is list)
          && (data.get('createdAt', null) == null || data.get('createdAt', '') is string)
          && (data.get('completedSteps', null) == null || data.get('completedSteps', []) is list);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isVerified()
                    && isValidUser(incoming()) 
                    && incoming().get('isPremium', false) == false
                    && incoming().get('points', 0) == 0
                    && incoming().get('requestCount', 0) == 0;
      allow update: if isOwner(userId) && isValidId(userId) && isVerified()
                    && isValidUser(incoming())
                    && incoming().uid == userId // Immutable
                    && incoming().get('isPremium', false) == existing().get('isPremium', false) // Security pillar: only admin/server should change this
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                         'points', 'sobrietyDate', 'recoveryStartDate', 'displayName', 'photoURL', 'lastGratitudeAt', 'requestCount', 'lastSobrietyCheck', 'completedSteps', 'email', 'higherPower', 'sponsorGender', 'birthDate', 'currentStep', 'language', 'challenges'
                       ]);
    }

    // -------------------------------------------------------------------------
    // GRATITUDES
    // -------------------------------------------------------------------------
    function isValidIdRef(id) {
        return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidGratitude(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.text is string && data.text.size() <= 1000
          && data.createdAt is string;
    }

    match /gratitudes/{gratitudeId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId) && isValidId(gratitudeId);
      allow create: if isOwner(incoming().userId) && isVerified() && isValidId(gratitudeId) && isValidGratitude(incoming());
      allow delete: if isOwner(existing().userId) && isValidId(gratitudeId);
    }

    // -------------------------------------------------------------------------
    // STEPS
    // -------------------------------------------------------------------------
    function isValidStep(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.stepNumber is int && data.stepNumber >= 1 && data.stepNumber <= 12
          && data.completedAt is string
          && (data.notes == null || (data.notes is string && data.notes.size() <= 5000));
    }

    match /steps/{stepId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId) && isValidId(stepId);
      allow create: if isOwner(incoming().userId) && isVerified() && isValidId(stepId) && isValidStep(incoming());
      allow update: if isOwner(existing().userId) && isVerified() && isValidId(stepId) && isValidStep(incoming())
                    && incoming().userId == existing().userId
                    && incoming().stepNumber == existing().stepNumber;
      allow delete: if isOwner(existing().userId) && isValidId(stepId);
    }

    // -------------------------------------------------------------------------
    // MESSAGES
    // -------------------------------------------------------------------------
    function isValidMessage(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.role in ['user', 'model']
          && data.content is string && data.content.size() <= 15000
          && data.createdAt is string;
    }

    match /messages/{messageId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId) && isValidId(messageId);
      allow create: if isOwner(incoming().userId) && isVerified() && isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isOwner(existing().userId) && isValidId(messageId);
    }
  }
}
