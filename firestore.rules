rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBALS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
          && data.email is string && data.email.size() <= 256
          && data.points is int && data.points >= 0
          && data.isPremium is bool
          && data.requestCount is int
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 500))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
          && (data.sobrietyDate == null || data.sobrietyDate is string)
          && (data.recoveryStartDate == null || data.recoveryStartDate is string)
          && (data.lastGratitudeAt == null || data.lastGratitudeAt is string)
          && (data.lastSobrietyCheck == null || data.lastSobrietyCheck is string)
          && (data.higherPower == null || (data.higherPower is string && data.higherPower.size() <= 100))
          && (data.sponsorGender == null || data.sponsorGender in ['parrain', 'marraine'])
          && (data.createdAt == null || data.createdAt is string)
          && (data.completedSteps == null || data.completedSteps is list);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && isValidUser(incoming()) 
                    && incoming().isPremium == false
                    && incoming().points == 0
                    && incoming().requestCount == 0;
      allow update: if isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().uid == userId // Immutable
                    && incoming().isPremium == existing().isPremium // User cannot change subscription status
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                         'points', 'sobrietyDate', 'recoveryStartDate', 'displayName', 'photoURL', 'lastGratitudeAt', 'requestCount', 'lastSobrietyCheck', 'completedSteps', 'email', 'higherPower', 'sponsorGender'
                       ]);
    }

    // -------------------------------------------------------------------------
    // GRATITUDES
    // -------------------------------------------------------------------------
    function isValidGratitude(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.text is string && data.text.size() <= 1000
          && data.createdAt is string;
    }

    match /gratitudes/{gratitudeId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidGratitude(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // -------------------------------------------------------------------------
    // STEPS
    // -------------------------------------------------------------------------
    function isValidStep(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.stepNumber is int && data.stepNumber >= 1 && data.stepNumber <= 12
          && data.completedAt is string
          && (data.notes == null || (data.notes is string && data.notes.size() <= 5000));
    }

    match /steps/{stepId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidStep(incoming());
      allow update: if isOwner(existing().userId) && isValidStep(incoming())
                    && incoming().userId == existing().userId
                    && incoming().stepNumber == existing().stepNumber;
      allow delete: if isOwner(existing().userId);
    }

    // -------------------------------------------------------------------------
    // MESSAGES
    // -------------------------------------------------------------------------
    function isValidMessage(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.role in ['user', 'model']
          && data.content is string && data.content.size() <= 10000
          && data.createdAt is string;
    }

    match /messages/{messageId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidMessage(incoming());
      allow delete: if isOwner(existing().userId);
    }
  }
}
