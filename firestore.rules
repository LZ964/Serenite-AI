rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBALS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // TEST CONNECTION
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
          && (data.email == null || (data.email is string && data.email.size() <= 256))
          && data.points is int && data.points >= 0
          && data.isPremium is bool
          && data.requestCount is int
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 500))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
          && (data.sobrietyDate == null || data.sobrietyDate is string)
          && (data.recoveryStartDate == null || data.recoveryStartDate is string)
          && (data.lastGratitudeAt == null || data.lastGratitudeAt is string)
          && (data.lastSobrietyCheck == null || data.lastSobrietyCheck is string)
          && (data.higherPower == null || (data.higherPower is string && data.higherPower.size() <= 100))
          && (data.sponsorGender == null || data.sponsorGender in ['parrain', 'marraine'])
          && (data.birthDate == null || data.birthDate is string)
          && (data.currentStep == null || data.currentStep is string)
          && (data.language == null || data.language is string)
          && (data.challenges == null || (data.challenges is list && data.challenges.size() <= 50))
          && (data.createdAt == null || data.createdAt is string)
          && (data.completedSteps == null || (data.completedSteps is list && data.completedSteps.size() <= 12));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isVerified()
                    && isValidUser(incoming()) 
                    && incoming().isPremium == false
                    && incoming().points == 0
                    && incoming().requestCount == 0
                    && incoming().keys().hasAll(['uid', 'points', 'isPremium', 'requestCount'])
                    && incoming().keys().size() <= 20;
      allow update: if isOwner(userId) && isValidId(userId) && isVerified()
                    && isValidUser(incoming())
                    && incoming().uid == userId // Immutable
                    && incoming().isPremium == existing().isPremium // Security pillar: only admin/server should change this
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                         'points', 'sobrietyDate', 'recoveryStartDate', 'displayName', 'photoURL', 'lastGratitudeAt', 'requestCount', 'lastSobrietyCheck', 'completedSteps', 'email', 'higherPower', 'sponsorGender', 'birthDate', 'currentStep', 'language', 'challenges'
                       ]);
    }

    // -------------------------------------------------------------------------
    // GRATITUDES
    // -------------------------------------------------------------------------
    function isValidIdRef(id) {
        return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidGratitude(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.text is string && data.text.size() <= 1000
          && data.createdAt is string;
    }

    match /gratitudes/{gratitudeId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId) && isValidId(gratitudeId);
      allow create: if isOwner(incoming().userId) && isVerified() && isValidId(gratitudeId) && isValidGratitude(incoming());
      allow delete: if isOwner(existing().userId) && isValidId(gratitudeId);
    }

    // -------------------------------------------------------------------------
    // STEPS
    // -------------------------------------------------------------------------
    function isValidStep(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.stepNumber is int && data.stepNumber >= 1 && data.stepNumber <= 12
          && data.completedAt is string
          && (data.notes == null || (data.notes is string && data.notes.size() <= 5000));
    }

    match /steps/{stepId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId) && isValidId(stepId);
      allow create: if isOwner(incoming().userId) && isVerified() && isValidId(stepId) && isValidStep(incoming());
      allow update: if isOwner(existing().userId) && isVerified() && isValidId(stepId) && isValidStep(incoming())
                    && incoming().userId == existing().userId
                    && incoming().stepNumber == existing().stepNumber;
      allow delete: if isOwner(existing().userId) && isValidId(stepId);
    }

    // -------------------------------------------------------------------------
    // MESSAGES
    // -------------------------------------------------------------------------
    function isValidMessage(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.role in ['user', 'model']
          && data.content is string && data.content.size() <= 15000
          && data.createdAt is string;
    }

    match /messages/{messageId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId) && isValidId(messageId);
      allow create: if isOwner(incoming().userId) && isVerified() && isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isOwner(existing().userId) && isValidId(messageId);
    }
  }
}
